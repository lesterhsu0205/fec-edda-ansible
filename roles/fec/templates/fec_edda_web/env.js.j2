  DEBUG: {{ fec_edda_web_config.debug | bool | lower }},
  MOCK_FUNCTIONS: {{ fec_edda_web_config.mock_functions | bool | lower }},
  SSO_ENABLED: {{ fec_edda_web_config.sso_enabled | bool | lower }},
  SSO_LOGIN_URL: '{{ fec_edda_web_config.sso_login_url }}',
  SSO_LOGOUT_URL: '{{ fec_edda_web_config.sso_logout_url }}'
}
