# =====================================================================
# FEC EDDA 部署主機機密檔（由 ansible 依 vars/vault 產生，勿手動修改）
# 格式與 fec-edda repo config/fec-edda-secrets.env.example 相同，僅保留本環境區塊
# =====================================================================

# 本主機環境身分（stg | uat | prd | dr）
DEPLOY_ENV={{ gv_env_name }}

{{ fec_secret_prefix }}_JASYPT_PASSWORD={{ fec_edda_secrets.jasypt_password | quote }}
{{ fec_secret_prefix }}_DB_URL={{ fec_edda_secrets.db_url | quote }}
{{ fec_secret_prefix }}_DB_PASS={{ fec_edda_secrets.db_pass | quote }}
{{ fec_secret_prefix }}_JWT_SECRET={{ fec_edda_secrets.jwt_secret | quote }}
{{ fec_secret_prefix }}_KEYSTORE_PASSWORD={{ fec_edda_secrets.keystore_password | quote }}
{{ fec_secret_prefix }}_WS_KEYSTORE_PASSWORD={{ fec_edda_secrets.ws_keystore_password | quote }}
{{ fec_secret_prefix }}_TRUSTSTORE_PASSWORD={{ fec_edda_secrets.truststore_password | quote }}
{{ fec_secret_prefix }}_MAC_KEY_A={{ fec_edda_secrets.mac_key_a | quote }}
{{ fec_secret_prefix }}_MAC_KEY_B={{ fec_edda_secrets.mac_key_b | quote }}
{{ fec_secret_prefix }}_MAC_KEY_C={{ fec_edda_secrets.mac_key_c | quote }}
